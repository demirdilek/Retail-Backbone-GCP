# --- Binaries and Build Artifacts ---
bin/
dist/
retail-edge
/retail-backbone
/scanner-service
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin

# --- Go Specific ---
vendor/
*.test
*.out
coverage.txt
# Check in go.sum for reproducible builds
# Ignore local workspace configurations
go.work
go.work.sum

# --- Secrets, Certificates & Credentials (CRITICAL) ---
*.key
*.pem
*.crt
*.p12
*.json
# Prevent local environment files from leaking
.env
.env.*
! .env.example

# Exceptions: Allow necessary configurations
!k8s/app.yaml
!inventory.json
!package.json
!docker-compose.yml
# Essential for the monitoring stack:
!monitoring/grafana/provisioning/dashboards/*.json

# --- Docker & Databases ---
postgres_data/
grafana-storage/
prometheus_data/
*.db
*.sqlite

# --- Infrastructure & Environment ---
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
.terraform.lock.hcl
# K3d / Local Cluster Configs
.k3d/
.kubeconfig
*.kubeconfig
kubeconfig

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
main

# --- Retail Edge Specifics (Makefile & Tunnels) ---
# Ignore all logs generated by background tunnel processes
*.log
prometheus.log
grafana.log
store-*.log
nohup.out
tailscale_state/
.vagrant/