# --- Binaries and Build Artifacts ---
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin
/retail-backbone
/scanner-service

# --- Go Specific ---
vendor/
*.test
*.out
coverage.txt
go.sum

# --- Secrets, Certificates & Credentials (CRITICAL) ---
# We block all keys, certs and json to prevent accidental leaks
*.key
*.pem
*.crt
*.p12
*.json
# Exceptions: Allow essential config files but NOT secrets
!app.yaml
!inventory.json
!package.json
!docker-compose.yml

# --- Docker & Databases ---
# Prevents local DB data from being pushed
postgres_data/
grafana-storage/
prometheus_data/
*.db
*.sqlite

# --- Infrastructure & Environment ---
.env
.env.*
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
.terraform.lock.hcl

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# --- Retail Edge Specifics ---
# If you store logs locally during development
*.log