# ==============================================================================
# Retail Edge - Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and replace the dummy values.
# For a purely local test, GCP_PROJECT can remain unchanged.

# --- Core Infrastructure ---
CLUSTER_NAME=retail-edge-local
GCP_PROJECT=your-gcp-project-id

# --- GitOps / Flux CD ---
GITHUB_USER=your-github-username
GITHUB_REPO=retail-edge

# --- Build Tools ---
GO_CMD=go

# --- Security / Networking (Optional for local demo) ---
TAILSCALE_AUTH_KEY=tskey-auth-dummy-key